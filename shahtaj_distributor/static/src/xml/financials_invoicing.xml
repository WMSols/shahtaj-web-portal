<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="shahtaj_distributor.FinancialsInvoicing" owl="1">
      <div class="card border-0 shadow-sm bg-white rounded-3">
        
        <div class="p-4 border-bottom bg-light d-flex justify-content-between align-items-center rounded-top">
            <div>
                <h2 class="h4 fw-bold text-dark mb-0">Financials &amp; Invoicing</h2>
                <small class="text-muted">Accounting controls and credit risk management.</small>
            </div>
            <div>
                <span class="badge bg-success px-3 py-2 text-white shadow-sm d-flex align-items-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-dollar-sign me-2"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg>
                    Finance Engine Active
                </span>
            </div>
        </div>

        <div class="p-3 border-bottom">
            <ul class="nav nav-pills nav-fill">
                <li class="nav-item me-2">
                    <button t-on-click="() => this.setSubTab('invoices')" 
                            t-attf-class="nav-link fw-bold rounded-pill border-0 px-4 py-2 w-100 transition-all d-flex justify-content-center align-items-center #{this.state.activeSubTab === 'invoices' ? 'active bg-dark text-white shadow-sm' : 'text-muted bg-white'}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-receipt me-2"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/></svg>
                        Invoice Management
                    </button>
                </li>
                <li class="nav-item">
                    <button t-on-click="() => this.setSubTab('credit')" 
                            t-attf-class="nav-link fw-bold rounded-pill border-0 px-4 py-2 w-100 transition-all d-flex justify-content-center align-items-center #{this.state.activeSubTab === 'credit' ? 'active bg-dark text-white shadow-sm' : 'text-muted bg-white'}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-credit-card me-2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
                        Credit Risk Control
                    </button>
                </li>
            </ul>
        </div>

        <t t-if="this.state.activeSubTab === 'invoices'">
            <div class="px-4 pt-3 bg-white border-bottom">
                <ul class="nav nav-tabs border-0">
                    <li class="nav-item me-3">
                        <button t-on-click="() => this.setInvoiceSubTab('orders')" 
                                t-attf-class="nav-link bg-transparent border-0 fw-bold pb-2 #{this.state.invoiceSubTab === 'orders' ? 'text-dark border-bottom border-dark border-2 rounded-0' : 'text-muted'}">
                            Orders to Invoice
                        </button>
                    </li>
                    <li class="nav-item me-3">
                        <button t-on-click="() => this.setInvoiceSubTab('customer_invoices')" 
                                t-attf-class="nav-link bg-transparent border-0 fw-bold pb-2 #{this.state.invoiceSubTab === 'customer_invoices' ? 'text-dark border-bottom border-dark border-2 rounded-0' : 'text-muted'}">
                            Customer Invoices
                        </button>
                    </li>
                    <li class="nav-item me-3">
                        <button t-on-click="() => this.setInvoiceSubTab('payments')" 
                                t-attf-class="nav-link bg-transparent border-0 fw-bold pb-2 #{this.state.invoiceSubTab === 'payments' ? 'text-dark border-bottom border-dark border-2 rounded-0' : 'text-muted'}">
                            Customer Payment
                        </button>
                    </li>
                    <li class="nav-item">
                        <button t-on-click="() => this.setInvoiceSubTab('balances')" 
                                t-attf-class="nav-link bg-transparent border-0 fw-bold pb-2 #{this.state.invoiceSubTab === 'balances' ? 'text-dark border-bottom border-dark border-2 rounded-0' : 'text-muted'}">
                            Shop Balances
                        </button>
                    </li>
                </ul>
            </div>

            <t t-if="this.state.invoiceSubTab === 'orders'">
                <t t-if="!this.state.selectedOrder">
                    <div class="p-3 bg-light border-bottom">
                        <div class="row g-2">
                            <div class="col-md-6">
                                <input type="text" class="form-control form-control-sm" placeholder="Search Shop or Order ID..." 
                                       t-model="this.state.ordersFilters.search" t-on-input="() => this.state.ordersPage = 1"/>
                            </div>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light text-uppercase small fw-bold text-muted">
                                <tr>
                                    <th class="border-top-0 ps-4">Order #</th>
                                    <th class="border-top-0">Shop</th>
                                    <th class="border-top-0">Date</th>
                                    <th class="border-top-0 text-end">Amount</th>
                                    <th class="border-top-0 text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="this.paginatedOrders.length === 0">
                                    <tr><td colspan="5" class="text-center py-4 text-muted">No orders pending invoice.</td></tr>
                                </t>
                                <t t-foreach="this.paginatedOrders" t-as="ord" t-key="ord.id">
                                    <tr>
                                        <td class="ps-4 fw-bold align-middle text-primary"><t t-esc="ord.display_name"/></td>
                                        <td class="align-middle fw-bold text-dark"><t t-esc="ord.shop"/></td>
                                        <td class="align-middle text-muted small"><t t-esc="ord.date"/></td>
                                        <td class="align-middle text-end fw-bold">Rs. <t t-esc="ord.amount"/></td>
                                        <td class="align-middle text-end pe-4">
                                            <button class="btn btn-sm btn-outline-dark fw-bold me-2" t-on-click="() => this.viewOrder(ord)">View Details</button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
                
                <t t-else="">
                    <div class="p-4" style="background-color: #f8fafc;">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <button class="btn btn-sm btn-light border shadow-sm fw-bold text-dark d-flex align-items-center" t-on-click="closeOrder">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left me-1"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                                Back to Orders
                            </button>
                            <div class="d-flex gap-2">
                                <button class="btn btn-danger fw-bold text-white shadow-sm">Reject Order</button>
                                <button class="btn btn-dark fw-bold text-white shadow-sm" t-on-click="() => this.triggerCreateInvoice(this.state.selectedOrder.id)">
                                    Confirm &amp; Create Invoice
                                </button>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm p-4 mb-4 rounded-3">
                            <h5 class="fw-bold text-dark mb-4">Order Details: <t t-esc="this.state.selectedOrder.display_name"/></h5>
                            <div class="row">
                                <div class="col-md-6 border-end">
                                    <h6 class="text-muted text-uppercase small fw-bold mb-2">Customer Info</h6>
                                    <h5 class="fw-bold text-dark mb-1"><t t-esc="this.state.selectedOrder.shop"/></h5>
                                </div>
                                <div class="col-md-6 ps-4">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted small">Order Date:</span>
                                        <span class="fw-bold text-dark"><t t-esc="this.state.selectedOrder.date"/></span>
                                    </div>
                                    <div class="d-flex justify-content-between bg-light p-2 rounded">
                                        <span class="fw-bold">Total Amount:</span>
                                        <span class="fw-bold text-success">Rs. <t t-esc="this.state.selectedOrder.amount"/></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>

                       <t t-if="this.state.invoiceSubTab === 'customer_invoices'">
                <t t-if="!this.state.selectedInvoice">
                    <div class="p-4 bg-white border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0">Consolidated Invoices</h6>
                        <button class="btn btn-sm btn-dark d-flex align-items-center text-white fw-bold" t-on-click="() => this.state.showInvoiceForm = true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus me-1"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                            Generate Invoice
                        </button>
                    </div>

                    <div class="p-3 bg-light border-bottom">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <input type="text" class="form-control form-control-sm" placeholder="Search Shop or ID..." 
                                       t-model="this.state.invoiceFilters.search" t-on-input="() => this.state.invoicePage = 1"/>
                            </div>
                            <div class="col-md-2">
                                <select class="form-select form-select-sm" t-model="this.state.invoiceFilters.status" t-on-change="() => this.state.invoicePage = 1">
                                    <option value="">All Statuses</option>
                                    <option value="Paid">Paid</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Draft">Draft</option>
                                </select>
                            </div>
                            <div class="col-md-3 d-flex gap-2">
                                <input type="number" class="form-control form-control-sm" placeholder="Min Amount" t-model="this.state.invoiceFilters.minAmount" t-on-input="() => this.state.invoicePage = 1"/>
                                <input type="number" class="form-control form-control-sm" placeholder="Max Amount" t-model="this.state.invoiceFilters.maxAmount" t-on-input="() => this.state.invoicePage = 1"/>
                            </div>
                            <div class="col-md-3 d-flex gap-2">
                                <input type="date" class="form-control form-control-sm" t-model="this.state.invoiceFilters.startDate" t-on-change="() => this.state.invoicePage = 1"/>
                                <input type="date" class="form-control form-control-sm" t-model="this.state.invoiceFilters.endDate" t-on-change="() => this.state.invoicePage = 1"/>
                            </div>
                            <div class="col-md-1">
                                <button class="btn btn-sm btn-outline-secondary w-100 fw-bold" t-on-click="resetInvoiceFilters">Clear</button>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light text-uppercase small fw-bold text-muted">
                                <tr>
                                    <th class="border-top-0 ps-4">Invoice #</th>
                                    <th class="border-top-0">Billed To</th>
                                    <th class="border-top-0">Timeline</th>
                                    <th class="border-top-0 text-end">Amount</th>
                                    <th class="border-top-0 text-center">Status</th>
                                    <th class="border-top-0 text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="this.paginatedInvoices.length === 0">
                                    <tr><td colspan="6" class="text-center py-4 text-muted">No invoices found matching criteria.</td></tr>
                                </t>
                                <t t-foreach="this.paginatedInvoices" t-as="inv" t-key="inv.id">
                                    <tr>
                                        <td class="ps-4 fw-bold align-middle text-primary"><t t-esc="inv.display_name"/></td>
                                        <td class="align-middle fw-bold text-dark"><t t-esc="inv.shop"/></td>
                                        <td class="align-middle">
                                            <div class="small text-muted">Issued: <t t-esc="inv.date"/></div>
                                            <div class="small fw-bold" t-attf-class="#{inv.status === 'Pending' ? 'text-danger' : ''}">Due: <t t-esc="inv.dueDate"/></div>
                                        </td>
                                        <td class="align-middle text-end fw-bold">Rs. <t t-esc="inv.amount"/></td>
                                        <td class="align-middle text-center">
                                            <span t-attf-class="badge #{inv.status === 'Paid' ? 'bg-success text-white' : inv.status === 'Pending' ? 'bg-warning text-dark' : 'bg-secondary text-white'} px-2 py-1 shadow-sm">
                                                <t t-esc="inv.status"/>
                                            </span>
                                        </td>
                                        <td class="align-middle text-end pe-4">
                                            <button class="btn btn-sm btn-outline-dark fw-bold" t-on-click="() => this.viewInvoice(inv)">View Details</button>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
                        <small class="text-muted fw-bold">
                            Showing <t t-esc="this.filteredInvoices.length === 0 ? 0 : ((this.state.invoicePage - 1) * this.state.itemsPerPage) + 1"/> to 
                            <t t-esc="Math.min(this.state.invoicePage * this.state.itemsPerPage, this.filteredInvoices.length)"/> of <t t-esc="this.filteredInvoices.length"/> entries
                        </small>
                        <div class="btn-group shadow-sm">
                            <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage('invoice', -1)" t-att-disabled="this.state.invoicePage === 1">Previous</button>
                            <button class="btn btn-sm btn-light border px-3 fw-bold disabled"><t t-esc="this.state.invoicePage"/> / <t t-esc="this.invoiceTotalPages"/></button>
                            <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage('invoice', 1)" t-att-disabled="this.state.invoicePage === this.invoiceTotalPages">Next</button>
                        </div>
                    </div>
                </t>
                
                                <t t-else="">
                    <div class="p-4 position-relative" style="background-color: #f8fafc; min-height: 400px;">
                        
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <button class="btn btn-sm btn-light border shadow-sm fw-bold text-dark d-flex align-items-center" t-on-click="closeInvoice">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left me-1"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                                Back to Ledger
                            </button>
                            
                            <div class="d-flex gap-2">
                                <button t-if="this.state.selectedInvoice.status !== 'Draft'" 
                                        class="btn btn-outline-dark fw-bold shadow-sm" 
                                        t-on-click="() => this.actionPrintInvoice(this.state.selectedInvoice.id)">
                                    Print PDF
                                </button>
                                
                                <button t-if="this.state.selectedInvoice.status === 'Draft'" 
                                        class="btn btn-dark fw-bold text-white shadow-sm" 
                                        t-on-click="() => this.actionConfirmInvoice(this.state.selectedInvoice)">
                                    Confirm Invoice
                                </button>

                                <button t-elif="this.state.selectedInvoice.status === 'Pending'" 
                                        class="btn btn-success fw-bold text-white shadow-sm" 
                                        t-on-click="() => this.openPaymentModal()">
                                    Register Payment
                                </button>
                                
                                </div>
                        </div>

                        <div class="card border-0 shadow-sm p-4 mb-4 rounded-3">
                            <div class="row">
                                <div class="col-md-6 border-end">
                                    <h6 class="text-muted text-uppercase small fw-bold mb-3">Billed To</h6>
                                    <h5 class="fw-bold text-dark mb-1"><t t-esc="this.state.selectedInvoice.shop"/></h5>
                                    <p class="text-muted mb-0 small">Status: 
                                        <strong t-attf-class="#{this.state.selectedInvoice.status === 'Paid' ? 'text-success' : this.state.selectedInvoice.status === 'Draft' ? 'text-secondary' : 'text-warning text-dark'}">
                                            <t t-esc="this.state.selectedInvoice.status"/>
                                        </strong>
                                    </p>
                                </div>
                                <div class="col-md-6 ps-4">
                                    <h6 class="text-muted text-uppercase small fw-bold mb-3">Invoice Details</h6>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted small">Invoice Number:</span>
                                        <span class="fw-bold text-dark"><t t-esc="this.state.selectedInvoice.display_name"/></span>
                                    </div>
                                    <div class="d-flex justify-content-between text-danger">
                                        <span class="small fw-bold">Amount:</span>
                                        <span class="fw-bold">Rs. <t t-esc="this.state.selectedInvoice.amount"/></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <t t-if="this.state.showPaymentModal">
                            <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-flex justify-content-center align-items-center" style="z-index: 1050; border-radius: 0.5rem;">
                                <div class="bg-white p-4 rounded-3 shadow-lg" style="width: 400px;">
                                    <h5 class="fw-bold text-dark mb-3">Register Payment</h5>
                                    
                                    <div class="mb-3">
                                        <label class="small fw-bold text-muted mb-1">Select Journal (Bank/Cash)</label>
                                        <select class="form-select" t-model="this.state.paymentForm.journal_id">
                                            <t t-foreach="this.state.journals" t-as="journal" t-key="journal.id">
                                                <option t-att-value="journal.id"><t t-esc="journal.name"/></option>
                                            </t>
                                        </select>
                                    </div>

                                    <div class="mb-4">
                                        <label class="small fw-bold text-muted mb-1">Payment Method</label>
                                        <select class="form-select" t-model="this.state.paymentForm.method">
                                            <option value="manual">Manual (Cash / Standard Transfer)</option>
                                            <option value="cheque">Cheque</option>
                                        </select>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                                        <button class="btn btn-light fw-bold border" t-on-click="closePaymentModal">Cancel</button>
                                        <button class="btn btn-success fw-bold text-white" t-on-click="processPayment">Validate Payment</button>
                                    </div>
                                </div>
                            </div>
                        </t>

                    </div>
                </t>

            </t>


            <t t-if="this.state.invoiceSubTab === 'payments'">
                <div class="p-3 bg-light border-bottom">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <input type="text" class="form-control form-control-sm" placeholder="Search Shop or Payment ID..." 
                                   t-model="this.state.paymentsFilters.search" t-on-input="() => this.state.paymentsPage = 1"/>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" t-model="this.state.paymentsFilters.method" t-on-change="() => this.state.paymentsPage = 1">
                                <option value="">All Methods</option>
                                <option value="Cash">Cash</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                                <option value="Cheque">Cheque</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light text-uppercase small fw-bold text-muted">
                            <tr>
                                <th class="border-top-0 ps-4">Payment #</th>
                                <th class="border-top-0">Shop</th>
                                <th class="border-top-0">Date</th>
                                <th class="border-top-0">Method</th>
                                <th class="border-top-0 text-end">Amount</th>
                                <th class="border-top-0 text-center pe-4">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="this.paginatedPayments.length === 0">
                                <tr><td colspan="6" class="text-center py-4 text-muted">No payments found.</td></tr>
                            </t>
                            <t t-foreach="this.paginatedPayments" t-as="pay" t-key="pay.id">
                                <tr>
                                    <td class="ps-4 fw-bold align-middle text-primary"><t t-esc="pay.id"/></td>
                                    <td class="align-middle fw-bold text-dark"><t t-esc="pay.shop"/></td>
                                    <td class="align-middle text-muted small"><t t-esc="pay.date"/></td>
                                    <td class="align-middle text-muted small"><t t-esc="pay.method"/></td>
                                    <td class="align-middle text-end fw-bold text-success">Rs. <t t-esc="pay.amount"/></td>
                                    <td class="align-middle text-center pe-4">
                                        <span class="badge bg-success text-white px-2 py-1 shadow-sm"><t t-esc="pay.status"/></span>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
                    <small class="text-muted fw-bold">
                        Showing <t t-esc="this.filteredPayments.length === 0 ? 0 : ((this.state.paymentsPage - 1) * this.state.itemsPerPage) + 1"/> to 
                        <t t-esc="Math.min(this.state.paymentsPage * this.state.itemsPerPage, this.filteredPayments.length)"/> of <t t-esc="this.filteredPayments.length"/> entries
                    </small>
                    <div class="btn-group shadow-sm">
                        <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage('payment', -1)" t-att-disabled="this.state.paymentsPage === 1">Previous</button>
                        <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage('payment', 1)" t-att-disabled="this.state.paymentsPage === this.paymentsTotalPages">Next</button>
                    </div>
                </div>
            </t>

            <t t-if="this.state.invoiceSubTab === 'balances'">
                <div class="p-3 bg-light border-bottom">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <input type="text" class="form-control form-control-sm" placeholder="Search Shop Name..." 
                                   t-model="this.state.balancesFilters.search" t-on-input="() => this.state.balancesPage = 1"/>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light text-uppercase small fw-bold text-muted">
                            <tr>
                                <th class="border-top-0 ps-4">Shop</th>
                                <th class="border-top-0 text-end">Total Billed</th>
                                <th class="border-top-0 text-end">Total Paid</th>
                                <th class="border-top-0 text-end pe-4">Outstanding Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="this.paginatedBalances.length === 0">
                                <tr><td colspan="4" class="text-center py-4 text-muted">No balances found.</td></tr>
                            </t>
                            <t t-foreach="this.paginatedBalances" t-as="bal" t-key="bal.shop">
                                <tr>
                                    <td class="ps-4 align-middle fw-bold text-dark"><t t-esc="bal.shop"/></td>
                                    <td class="align-middle text-end text-muted">Rs. <t t-esc="bal.billed"/></td>
                                    <td class="align-middle text-end text-success">Rs. <t t-esc="bal.paid"/></td>
                                    <td class="align-middle text-end fw-bold text-danger pe-4">Rs. <t t-esc="bal.outstanding"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
                <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
                    <small class="text-muted fw-bold">
                        Showing <t t-esc="this.filteredBalances.length === 0 ? 0 : ((this.state.balancesPage - 1) * this.state.itemsPerPage) + 1"/> to 
                        <t t-esc="Math.min(this.state.balancesPage * this.state.itemsPerPage, this.filteredBalances.length)"/> of <t t-esc="this.filteredBalances.length"/> entries
                    </small>
                    <div class="btn-group shadow-sm">
                        <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage('balance', -1)" t-att-disabled="this.state.balancesPage === 1">Previous</button>
                        <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage('balance', 1)" t-att-disabled="this.state.balancesPage === this.balancesTotalPages">Next</button>
                    </div>
                </div>
            </t>

        </t>

        <t t-if="this.state.activeSubTab === 'credit'">
            <div class="p-4 bg-white border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Shop Credit Limit Monitor</h6>
            </div>

            <div class="p-3 bg-light border-bottom">
                <div class="row g-2">
                    <div class="col-md-5">
                        <input type="text" class="form-control form-control-sm" placeholder="Search Shop Name or ID..." 
                               t-model="this.state.creditFilters.search" t-on-input="() => this.state.creditPage = 1"/>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" t-model="this.state.creditFilters.status" t-on-change="() => this.state.creditPage = 1">
                            <option value="">All Risk Statuses</option>
                            <option value="Healthy">Healthy</option>
                            <option value="Critical">Critical</option>
                            <option value="Exceeded">Exceeded</option>
                        </select>
                    </div>
                </div>
            </div>

            <t t-if="this.state.showLimitForm">
                <div class="p-4 bg-light border-bottom d-flex align-items-end shadow-sm">
                    <div class="me-3 flex-grow-1">
                        <label class="small fw-bold">Adjust Limit for Selected Shop</label>
                        <input type="number" class="form-control" t-model="this.state.limitForm.newLimit"/>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-secondary fw-bold" t-on-click="() => this.state.showLimitForm = false">Cancel</button>
                        <button class="btn btn-primary fw-bold text-white" t-on-click="updateCreditLimit">Apply New Limit</button>
                    </div>
                </div>
            </t>

            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light text-uppercase small fw-bold text-muted">
                        <tr>
                            <th class="border-top-0 ps-4">Shop Details</th>
                            <th class="border-top-0 w-25">Credit Utilization</th>
                            <th class="border-top-0 text-end">Available Credit</th>
                            <th class="border-top-0 text-center">Risk Status</th>
                            <th class="border-top-0 text-end pe-4">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="this.paginatedCredits.length === 0">
                            <tr><td colspan="5" class="text-center py-4 text-muted">No credit records found.</td></tr>
                        </t>
                        <t t-foreach="this.paginatedCredits" t-as="credit" t-key="credit.id">
                            <tr>
                                <td class="ps-4 align-middle">
                                    <div class="text-dark fw-bold"><t t-esc="credit.shop"/></div>
                                    <small class="text-muted">ID: <t t-esc="credit.id"/></small>
                                </td>
                                <td class="align-middle">
                                    <div class="d-flex justify-content-between mb-1">
                                        <small class="fw-bold text-dark">Rs. <t t-esc="credit.utilized"/></small>
                                        <small class="text-muted">Limit: Rs. <t t-esc="credit.limit"/></small>
                                    </div>
                                    <div class="progress" style="height: 8px;">
                                        <div t-attf-class="progress-bar #{credit.status === 'Healthy' ? 'bg-success' : credit.status === 'Critical' ? 'bg-warning' : 'bg-danger'}" 
                                             role="progressbar" 
                                             t-attf-style="width: #{(credit.utilized / credit.limit) * 100}%; max-width: 100%;"></div>
                                    </div>
                                </td>
                                <td class="align-middle text-end fw-bold">
                                    <t t-if="credit.limit - credit.utilized &lt; 0">
                                        <span class="text-danger">Rs. 0</span>
                                    </t>
                                    <t t-else="">
                                        Rs. <t t-esc="credit.limit - credit.utilized"/>
                                    </t>
                                </td>
                                <td class="align-middle text-center">
                                    <span t-attf-class="badge #{credit.status === 'Healthy' ? 'bg-success text-white' : credit.status === 'Critical' ? 'bg-warning text-dark' : 'bg-danger text-white'} px-2 py-1 shadow-sm">
                                        <t t-esc="credit.status"/>
                                    </span>
                                </td>
                                <td class="align-middle text-end pe-4">
                                    <button class="btn btn-sm btn-outline-secondary fw-bold d-flex align-items-center ms-auto" t-on-click="() => this.openLimitForm(credit)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil me-1"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                        Edit Limit
                                    </button>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <div class="p-3 border-top d-flex justify-content-between align-items-center bg-light">
                <small class="text-muted fw-bold">
                    Showing <t t-esc="this.filteredCredits.length === 0 ? 0 : ((this.state.creditPage - 1) * this.state.itemsPerPage) + 1"/> to 
                    <t t-esc="Math.min(this.state.creditPage * this.state.itemsPerPage, this.filteredCredits.length)"/> of <t t-esc="this.filteredCredits.length"/> entries
                </small>
                <div class="btn-group shadow-sm">
                    <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage('credit', -1)" t-att-disabled="this.state.creditPage === 1">Previous</button>
                    <button class="btn btn-sm btn-light border px-3 fw-bold disabled"><t t-esc="this.state.creditPage"/> / <t t-esc="this.creditTotalPages"/></button>
                    <button class="btn btn-sm btn-white border fw-bold" t-on-click="() => this.changePage('credit', 1)" t-att-disabled="this.state.creditPage === this.creditTotalPages">Next</button>
                </div>
            </div>

        </t>
      </div>
    </t>
</templates>

            

            
