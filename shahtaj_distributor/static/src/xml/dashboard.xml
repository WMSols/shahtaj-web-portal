<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="shahtaj_distributor.DashboardViewTemplate" owl="1">
        <div class="d-flex w-100 h-100 bg-light" style="font-family: sans-serif; min-height: 85vh;">

            <div class="bg-white border-right shadow-sm" style="width: 280px; min-width: 280px;">

                <div class="p-4 border-bottom text-center bg-light">
                    <img src="/web/binary/company_logo" alt="Shahtaj Oil Logo" style="max-height: 120px; width: 100%; object-fit: contain;" class="mb-2"/>
                    <h6 class="mb-0 font-weight-bold text-dark mt-2">Distributor Portal</h6>
                </div>

                <div class="list-group list-group-flush p-3 font-weight-bold">

                    <button t-on-click="() => this.switchTab('dashboard')" class="list-group-item list-group-item-action border-0 rounded mb-2 text-left d-flex align-items-center transition-all" t-att-style="this.state.activeTab === 'dashboard' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                        <span class="mr-3 d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="7" height="9" x="3" y="3" rx="1"/>
                                <rect width="7" height="5" x="14" y="3" rx="1"/>
                                <rect width="7" height="9" x="14" y="12" rx="1"/>
                                <rect width="7" height="5" x="3" y="16" rx="1"/>
                            </svg>
                        </span>
                        Dashboard
                    </button>

                    <button t-on-click="() => this.switchTab('territory')" class="list-group-item list-group-item-action border-0 rounded mb-2 text-left d-flex align-items-center transition-all" t-att-style="this.state.activeTab === 'territory' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                        <span class="mr-3 d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
                                <line x1="9" x2="9" y1="3" y2="18"/>
                                <line x1="15" x2="15" y1="6" y2="21"/>
                            </svg>
                        </span>
                        Territory &amp; Routes
                    </button>

                    <button t-on-click="() => this.switchTab('warehouse')" class="list-group-item list-group-item-action border-0 rounded mb-2 text-left d-flex align-items-center transition-all" t-att-style="this.state.activeTab === 'warehouse' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                        <span class="mr-6 d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/>
                                <path d="M17 18h1"/>
                                <path d="M12 18h1"/>
                                <path d="M7 18h1"/>
                            </svg>
                        </span>
                        Warehouse &amp; Stock
                    </button>

                    <button t-on-click="() => this.switchTab('operations')" class="list-group-item list-group-item-action border-0 rounded mb-2 text-left d-flex align-items-center transition-all" t-att-style="this.state.activeTab === 'operations' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                        <span class="mr-3 d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                                <circle cx="12" cy="10" r="3"/>
                            </svg>
                        </span>
                        Operations Tracking
                    </button>

                    <button t-on-click="() => this.switchTab('financials')" class="list-group-item list-group-item-action border-0 rounded mb-2 text-left d-flex align-items-center transition-all" t-att-style="this.state.activeTab === 'financials' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                        <span class="mr-3 d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect width="20" height="14" x="2" y="5" rx="2"/>
                                <line x1="2" x2="22" y1="10" y2="10"/>
                            </svg>
                        </span>
                        Financials
                    </button>
                     <button t-on-click="() => this.switchTab('schedules')" class="list-group-item list-group-item-action border-0 rounded mb-2 text-left d-flex align-items-center transition-all" t-att-style="this.state.activeTab === 'schedules' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                        <span class="mr-3 d-flex align-items-center">
                           <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-days-icon lucide-calendar-days"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></svg>
                        </span>
                        Schedules &amp; Targets
                    </button>

                    <hr class="my-2"/>

                    <button t-on-click="() => this.switchTab('staff')" class="list-group-item list-group-item-action border-0 rounded mb-2 text-left d-flex align-items-center transition-all" t-att-style="this.state.activeTab === 'staff' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                        <span class="mr-3 d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </span>
                        Staff Management
                    </button> 
                    <button t-on-click="() => this.switchTab('settings')" class="list-group-item list-group-item-action border-0 rounded mb-2 text-left d-flex align-items-center transition-all" t-att-style="this.state.activeTab === 'settings' ? 'background-color: #0f172a; color: #ffffff;' : 'color: #4b5563; background-color: transparent;'">
                        <span class="mr-3 d-flex align-items-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-settings-icon lucide-settings"><path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"/><circle cx="12" cy="12" r="3"/></svg>
                        </span>
                        Settings
                    </button>
                </div>
            </div>

            <div class="flex-grow-1 p-5" style="overflow-y: auto;">

                <t t-if="this.state.activeTab === 'dashboard'">

                    <div class="mb-4 border-bottom pb-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="h3 font-weight-bold text-dark mb-0">Command Center</h1>
                            <small class="text-muted">Real-time systemic overview of distribution operations.</small>
                        </div>
                        <div>
                            <span class="badge badge-light border text-muted px-3 py-2">
                                <i class="fa fa-clock-o mr-1"></i> Live Data Feed Active
                            </span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0 p-4 bg-white h-100" style="border-left: 4px solid #3b82f6 !important;">
                                <span class="text-muted text-uppercase small font-weight-bold">Today's Orders</span>
                                <h2 class="font-weight-bold text-dark mt-2 mb-0">184</h2>
                                <small class="text-success font-weight-bold mt-1">
                                    <i class="fa fa-arrow-up"></i> 12% vs Yesterday</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0 p-4 bg-white h-100" style="border-left: 4px solid #10b981 !important;">
                                <span class="text-muted text-uppercase small font-weight-bold">Daily Revenue</span>
                                <h2 class="font-weight-bold text-dark mt-2 mb-0">Rs. 6.2M</h2>
                                <small class="text-success font-weight-bold mt-1">
                                    <i class="fa fa-check-circle"></i> On Target</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0 p-4 bg-white h-100" style="border-left: 4px solid #f59e0b !important;">
                                <span class="text-muted text-uppercase small font-weight-bold">Active Deliveries</span>
                                <h2 class="font-weight-bold text-dark mt-2 mb-0">42</h2>
                                <small class="text-muted mt-1">12 Pending | 30 In-Transit</small>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card shadow-sm border-0 p-4 bg-white h-100" style="border-left: 4px solid #6366f1 !important;">
                                <span class="text-muted text-uppercase small font-weight-bold">Active Field Staff</span>
                                <h2 class="font-weight-bold text-dark mt-2 mb-0">28 / 35</h2>
                                <small class="text-muted mt-1">Checked-in today</small>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-8">
                            <div class="card border-0 shadow-sm bg-white h-100">
                                <div class="p-3 border-bottom bg-light">
                                    <h6 class="mb-0 font-weight-bold text-dark">
                                        <i class="fa fa-bolt text-warning mr-2"></i>Recent Field Activity</h6>
                                </div>
                                <div class="list-group list-group-flush">
                                    <div class="list-group-item border-0 py-3 d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center mr-3 shadow-sm" style="width: 35px; height: 35px;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="8" cy="21" r="1"/>
                                                <circle cx="19" cy="21" r="1"/>
                                                <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
                                            </svg>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between">
                                                <strong class="text-dark">New Order Generated</strong>
                                                <small class="text-muted">2 mins ago</small>
                                            </div>
                                            <small class="text-muted">Ali Khan booked an order of Rs. 45,000 at Bismillah General Store.</small>
                                        </div>
                                    </div>
                                    <div class="list-group-item border-0 py-3 d-flex align-items-center bg-light">
                                        <div class="bg-success text-white rounded-circle d-flex justify-content-center align-items-center mr-3 shadow-sm" style="width: 35px; height: 35px;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                                                <circle cx="12" cy="10" r="3"/>
                                            </svg>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between">
                                                <strong class="text-dark">Shop Check-in</strong>
                                                <small class="text-muted">15 mins ago</small>
                                            </div>
                                            <small class="text-muted">Usman Tariq checked into Madina Traders (Route B).</small>
                                        </div>
                                    </div>
                                    <div class="list-group-item border-0 py-3 d-flex align-items-center">
                                        <div class="bg-info text-white rounded-circle d-flex justify-content-center align-items-center mr-3 shadow-sm" style="width: 35px; height: 35px;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="15" height="13" x="1" y="3" rx="2"/>
                                                <path d="M16 8h4l3 3v5h-7V8z"/>
                                                <circle cx="5.5" cy="18.5" r="2.5"/>
                                                <circle cx="18.5" cy="18.5" r="2.5"/>
                                            </svg>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between">
                                                <strong class="text-dark">Delivery Completed</strong>
                                                <small class="text-muted">1 hour ago</small>
                                            </div>
                                            <small class="text-muted">Kamran Ali completed manifest DLV-0093.</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm bg-white h-100">
                                <div class="p-3 border-bottom bg-light">
                                    <h6 class="mb-0 font-weight-bold text-danger">
                                        <i class="fa fa-exclamation-triangle mr-2"></i>Critical Alerts</h6>
                                </div>
                                <div class="p-3">
                                    <div class="alert alert-danger border-0 shadow-sm mb-3 px-3 py-2">
                                        <div class="d-flex align-items-center">
                                            <div class="mr-3 text-danger">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                                                    <line x1="12" x2="12" y1="9" y2="13"/>
                                                    <line x1="12" x2="12.01" y1="17" y2="17"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <strong class="d-block small">Credit Limit Exceeded</strong>
                                                <small>Al-Hafeez Supermart has utilized 98% of their limit.</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="alert alert-warning border-0 shadow-sm mb-0 px-3 py-2 text-dark">
                                        <div class="d-flex align-items-center">
                                            <div class="mr-3 text-warning text-dark">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="m7.5 4.27 9 5.15"/>
                                                    <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/>
                                                    <path d="m3.3 7 8.7 5 8.7-5"/>
                                                    <path d="M12 22V12"/>
                                                </svg>
                                            </div>
                                            <div>
                                                <strong class="d-block small">Low Stock Warning</strong>
                                                <small>Shahtaj Banaspati 5kg Tin is Out of Stock in Central Hub.</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm bg-white">
                        <div class="p-3 border-bottom bg-light">
                            <h6 class="mb-0 font-weight-bold text-dark">
                                <i class="fa fa-globe text-secondary mr-2"></i>Distribution Network Overview</h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-3 border-right">
                                    <h3 class="font-weight-bold text-dark mb-0">3</h3>
                                    <span class="text-muted text-uppercase small font-weight-bold">Mapped Areas</span>
                                </div>
                                <div class="col-md-3 border-right">
                                    <h3 class="font-weight-bold text-dark mb-0">12</h3>
                                    <span class="text-muted text-uppercase small font-weight-bold">Active Routes</span>
                                </div>
                                <div class="col-md-3 border-right">
                                    <h3 class="font-weight-bold text-dark mb-0">145</h3>
                                    <span class="text-muted text-uppercase small font-weight-bold">Registered Shops</span>
                                </div>
                                <div class="col-md-3">
                                    <h3 class="font-weight-bold text-dark mb-0">2</h3>
                                    <span class="text-muted text-uppercase small font-weight-bold">Warehouses</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </t>

                <t t-if="this.state.activeTab === 'territory'">
                    <TerritoryRoutes />
                </t>

                <t t-if="this.state.activeTab === 'warehouse'">
                    <WarehouseInventory />
                </t>

                <t t-if="this.state.activeTab === 'operations'">
                    <OperationsTracking />
                </t>

                <t t-if="this.state.activeTab === 'financials'">
                    <FinancialsInvoicing />
                </t>

                <t t-if="this.state.activeTab === 'staff'">
                    <StaffManagement />
                </t> 
                 <t t-if="this.state.activeTab === 'settings'">
                    <PortalSettings />
                </t>  
                <t t-if="this.state.activeTab === 'schedules'">
                    <SchedulesTargets />
                </t>

            </div>
        </div>
    </t>
</templates>
