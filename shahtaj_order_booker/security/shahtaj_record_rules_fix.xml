<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Rule 1: Distributors can only see order bookers or themselves in res.users -->
        <record id="rule_shahtaj_distributor_read_bookers" model="ir.rule">
            <field name="name">Distributor: read order bookers and self</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="groups" eval="[(4, ref('shahtaj_order_.group_distributor'))]"/>
            <field name="domain_force">[
                '|',
                ('shahtaj_is_order_booker', '=', True),
                ('id', '=', user.id),
            ]</field>
        </record>

        <!-- Rule 2: Shop visibility rule — scope to distributors only -->
        <record id="rule_shahtaj_shop_booker_own" model="ir.rule">
            <field name="name">Distributor: read own shops and assigned shops</field>
            <field name="model_id" ref="shahtaj_order_.model_res_partner"/> <!-- adjust ref -->
            <field name="groups" eval="[(4, ref('shahtaj_order_.group_distributor'))]"/>
            <field name="domain_force">[
                '|',
                ('is_shahtaj_shop', '=', False),
                '|',
                ('registered_by_id', '=', user.id),
                ('route_id.weekly_schedule_ids.order_booker_id', '=', user.id),
            ]</field>
        </record>

        <delete model="ir.rule" id="rule_shahtaj_route_booker_read"/>
        <delete model="ir.rule" id="rule_shahtaj_zone_booker_read"/>

    </data>
</odoo>